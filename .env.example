# Copier ce fichier en .env et renseigner les valeurs réelles. Ne jamais commiter .env.

# Base de données PostgreSQL (Railway, Neon ou Supabase)
DATABASE_URL="postgresql://user:password@host:port/database"

# Cloudinary — upload des médias
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# Resend — envoi d'emails (réinitialisation de mot de passe, puis formulaire de contact en phase 7)
RESEND_API_KEY=""

# URL publique du site, utilisée dans les liens envoyés par email
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — dons en ligne (clés de test tant que le compte n'est pas en
# production : dashboard.stripe.com/test/apikeys). Le formulaire de don
# reste désactivé tant que ces variables sont vides.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Généré après avoir créé le endpoint webhook sur dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=""
