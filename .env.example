# Copier ce fichier en .env et renseigner les valeurs réelles. Ne jamais commiter .env.

# Base de données PostgreSQL (Railway, Neon ou Supabase)
DATABASE_URL="postgresql://user:password@host:port/database"

# Cloudinary — upload des médias
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# Resend — envoi d'emails (réinitialisation de mot de passe, puis formulaire de contact en phase 7)
RESEND_API_KEY=""

# URL publique du site, utilisée dans les liens envoyés par email
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Square — dons en ligne (identifiants sandbox tant que le compte n'est
# pas en production : developer.squareup.com/apps). Le formulaire de don
# reste désactivé tant que ces variables sont vides. Location ID et
# Environment ne sont pas des secrets (visibles côté navigateur pour le Web
# Payments SDK) : une seule variable NEXT_PUBLIC_ suffit, lue aussi côté
# serveur — inutile de la dupliquer sous un nom sans préfixe.
SQUARE_ACCESS_TOKEN=""
# Généré après avoir créé l'abonnement webhook sur developer.squareup.com/apps/webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# URL exacte déclarée pour l'abonnement webhook (doit correspondre pour que
# la vérification de signature réussisse) ; laisser vide en local.
SQUARE_WEBHOOK_NOTIFICATION_URL=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"
