# Copier ce fichier en .env et renseigner les valeurs réelles. Ne jamais commiter .env.

# Base de données PostgreSQL (Railway, Neon ou Supabase)
DATABASE_URL="postgresql://user:password@host:port/database"

# Cloudinary — upload des médias
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# Resend — envoi d'emails (formulaire de contact, réinitialisation de mot de passe)
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL=""
